# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project runtime data (excluded from source)
data/corpus/downloads/
data/corpus/sources.json
data/local_sources/inbox/
data/local_sources/incoming/
data/raw/
data/tokenizer/
data/corpus/index/
data/corpus/shards/
# Encoded training datasets (shards + manifests) — several GB, regenerated
# by prepare_data from the raw corpus. Never commit these.
data/processed/
reports/
checkpoints/
artifacts/
.studio_backups/
.upgrade_backups/
logs/
# TensorBoard / metric event logs
runs/

# Model weights wherever they land (checkpoints/ covers the default dir,
# this catches ad-hoc output_dir overrides too)
*.pt
*.safetensors
*.ckpt
*.onnx
*.gguf

# Plain-text logs outside logs/
*.log

# Environment files
.env
.env.local
*.secret

# Windows scripts are source and tracked (Studio launch + upgrade helpers).
# They are not generated artifacts, so they must not be ignored.

# Hardware autotuner output is machine-local — every PC measures different
# timings, so autotuned configs stay out of the repo. The example template
# IS committed (it is documentation), everything else is not.
configs/autotuned_*.yaml
!configs/autotuned_night.example.yaml

# Test caches
.pytest_cache/

# Upgrade templates live in tools/upgrade (optional; package build output)
tools/upgrade/payload/

# MkDocs build output (GitHub Pages)
site/
